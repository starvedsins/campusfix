{
  "name": "campusfix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "tsx scripts/local-db.ts",
    "db:docker": "docker compose up -d",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:prepare": "tsx scripts/prepare.ts",
    "jobs": "tsx scripts/jobs.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test",
    "deploy": "vercel --prod",
    "local": "tsx scripts/local.ts",
    "docs:source": "tsx scripts/source-listing.ts",
    "docs:whitebox": "tsx scripts/whitebox.ts",
    "docs:evidence": "tsx scripts/evidence.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@vercel/blob": "2.8.2",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "idb": "8.0.4",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "workflow": "5.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "16.15.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vercel": "65.8.0",
    "vitest": "5.0.5"
  },
  "type": "module",
  "overrides": {
    "zod": "$zod",
    "@fastify/busboy": "3.2.4",
    "tar": "7.5.22",
    "smol-toml": "1.9.1",
    "ajv@^8": "8.20.0",
    "esbuild": "0.28.2",
    "js-yaml@^4": "4.3.2",
    "minimatch@^10": "10.2.6",
    "path-to-regexp@^6": "6.3.0",
    "path-to-regexp@^8": "8.4.2",
    "undici": "7.30.1"
  }
}
